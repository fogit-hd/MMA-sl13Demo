# Firebase — tự động từ google-services.json (npm run sync:firebase)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_project_number
EXPO_PUBLIC_FIREBASE_APP_ID=1:your_project_number:android:your_app_hash

# Google Gemini — lấy key tại https://aistudio.google.com/apikey
# Sau khi sửa file này: npx expo start --dev-client --clear (hoặc build lại APK)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
